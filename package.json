{
  "name": "oka-wh-app",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:codespace": "node scripts/start-codespace.mjs",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:logic && npm run test:oauth",
    "test:logic": "tsc -p tsconfig.test.json && node .test-build/scripts/test-logic.js",
    "verify": "node scripts/verify-live.mjs",
    "bundle:android": "expo export --platform android --output-dir dist",
    "shopify:token": "node scripts/shopify-token.mjs",
    "test:oauth": "node scripts/test-oauth.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-media-library": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
