# ── Shopify ──────────────────────────────────────────────────────────────────
# Shopify no longer lets you create custom apps in the admin, so there is no
# permanent `shpat_` token to paste here. Instead, create an app in the Dev
# Dashboard (dev.shopify.com) and copy its Client ID + Client secret from
# Settings. The app exchanges them for an access token that lasts 24 hours and
# mints a new one automatically — nothing to renew by hand.
#
# In the Dev Dashboard, on the app's version, select these access scopes, then
# release the version and install the app on the store:
#   read_orders, write_orders            — order list, note journal, tags, cancel
#   read_order_edits, write_order_edits  — quantity changes and added products
#   read_products                        — the "add product" catalogue
#   read_customers                       — customer name and phone
#   read_files, write_files              — photo and call-recording uploads
#
# The app and the store must belong to the same Dev Dashboard organization.
SHOPIFY_STORE_DOMAIN=756009.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Optional permanent token. `npm run shopify:token -- --permanent` fills this in
# after a one-time browser approval. When set, the app uses it and the Client
# secret above is left out of the app bundle.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Redirect URL used by that approval; must be registered on the app version.
SHOPIFY_REDIRECT_URI=https://example.com/callback

# ── Bosta API ────────────────────────────────────────────────────────────────
# Bosta dashboard → Settings → API Integration
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2

# ── Gemini (call transcription) ──────────────────────────────────────────────
# aistudio.google.com → Get API key. Optional: without it, call recordings are
# still uploaded to the order, just not transcribed.
GEMINI_API_KEY=
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# ── Optional backend proxy ───────────────────────────────────────────────────
# Leave blank to call Shopify/Bosta directly from the device (simplest, and what
# Expo Go testing uses). Set it to your own server to keep credentials off the
# handset for a wider rollout — the app then sends no secrets of its own.
API_PROXY_URL=
